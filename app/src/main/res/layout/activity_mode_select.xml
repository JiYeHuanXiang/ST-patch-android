<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202124"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="10dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SillyTavern Patch"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择模式（点卡片展开）"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- 启动：自带内核，单按钮 -->
        <Button
            android:id="@+id/btnLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="启动（自带内核，免 Termux）"
            android:backgroundTint="#FF03DAC5"
            android:textColor="#FFFFFFFF" />

        <!-- 文件管理：角色卡公共目录映射（可选） -->
        <Button
            android:id="@+id/btnPublicChars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="文件管理（角色卡公共目录）"
            android:backgroundTint="#5A5A5D"
            android:textColor="#FFFFFFFF" />

        <!-- 接管模式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2A2A2D"
            android:layout_marginBottom="10dp"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/cardTakeoverHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="接管模式"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardTakeoverHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="展开 ▼"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTakeoverDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mode_takeover_desc"
                    android:textColor="#BFFFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTakeover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="接管"
                    android:backgroundTint="#FF03DAC5"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- 数据迁移模式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2A2A2D"
            android:layout_marginBottom="10dp"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/cardMigrateHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="数据迁移"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardMigrateHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="展开 ▼"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardMigrateDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mode_patch_desc"
                    android:textColor="#BFFFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMigrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="数据迁移"
                    android:backgroundTint="#FF03DAC5"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- 修补模式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2A2A2D"
            android:layout_marginBottom="10dp"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/cardUpgradeHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="修补模式"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardUpgradeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="展开 ▼"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardUpgradeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mode_upgrade_desc"
                    android:textColor="#BFFFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUpgrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="修补"
                    android:backgroundTint="#FF03DAC5"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- 影子模式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2A2A2D"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/cardShadowHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="影子模式"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardShadowHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="展开 ▼"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardShadowDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mode_shadow_desc"
                    android:textColor="#BFFFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnShadow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="影子模式"
                    android:backgroundTint="#FF03DAC6"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- 存储权限：申请管理所有文件权限（部分机型导入角色卡/文件所需） -->
        <Button
            android:id="@+id/btnStoragePerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="存储权限（无法导入角色卡时点此）"
            android:backgroundTint="#3A3A3D"
            android:textColor="#FFFFFFFF" />

        <!-- 设置：编辑 app 自带内核私有目录里的 config.yaml（内置编辑器是唯一入口） -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="设置（编辑酒馆 config.yaml）"
            android:backgroundTint="#3A3A3D"
            android:textColor="#FFFFFFFF" />

    </LinearLayout>
</ScrollView>
