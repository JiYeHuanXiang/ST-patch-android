<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <!-- 顶部状态与操作区：启动/复制/导入三按钮独立控制可见性，互不隐藏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_icon_box"
            android:backgroundTint="@color/st_shadow_box">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mode_shadow"
                app:tint="@color/st_shadow" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="影子模式"
            android:textColor="@color/st_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/shadowProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:progressDrawable="@drawable/bg_progress_rounded"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/st_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            style="@style/Widget.STPatch.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="启动影子酒馆"
            app:icon="@drawable/ic_mode_launch"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/st_on_accent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyButton"
            style="@style/Widget.STPatch.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="从 Termux 复制酒馆"
            app:icon="@drawable/ic_mode_migrate"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="18dp"
            app:iconTint="@color/st_accent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importButton"
            style="@style/Widget.STPatch.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="导入影子副本"
            app:icon="@drawable/ic_folder"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="18dp"
            app:iconTint="@color/st_accent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.STPatch.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="12dp"
            android:text="重试"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="16dp"
            app:iconTint="@color/st_accent"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 启动日志区（点「启动影子酒馆」后显示） -->
    <LinearLayout
        android:id="@+id/logBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启动日志"
                android:textColor="@color/st_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyLogButton"
                style="@style/Widget.STPatch.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="复制"
                android:textSize="11sp"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_console"
            android:padding="10dp"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/logTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/st_log_text"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:lineSpacingExtra="1dp" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
