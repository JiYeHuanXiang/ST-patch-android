<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置 — config.yaml"
        android:textColor="@color/st_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/editorHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/st_text_hint"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLazyLoad"
        style="@style/Widget.STPatch.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="一键启用角色懒加载（修「角色长度已达上限」）"
        android:textSize="13sp"
        app:icon="@drawable/ic_mode_patch"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="16dp"
        app:iconTint="@color/st_accent"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/configEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:background="@drawable/bg_log_console"
        android:padding="12dp"
        android:typeface="monospace"
        android:textColor="@color/st_log_text"
        android:textSize="12sp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollHorizontally="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveConfig"
        style="@style/Widget.STPatch.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="保存"
        android:layout_marginTop="10dp" />

</LinearLayout>
