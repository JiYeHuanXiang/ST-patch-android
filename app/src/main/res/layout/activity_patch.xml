<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_icon_box"
        android:backgroundTint="@color/st_migrate_box">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mode_migrate"
            app:tint="@color/st_migrate" />
    </FrameLayout>

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="数据迁移"
        android:textColor="@color/st_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:indeterminateTint="@color/st_accent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在准备迁移…"
        android:textColor="@color/st_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <LinearLayout
        android:id="@+id/categoryBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_inner"
        android:padding="18dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cbCharacters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:text="角色卡（characters）"
            android:textColor="@color/st_text_primary"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbChats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:text="聊天记录（chats）"
            android:textColor="@color/st_text_primary"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbSecrets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:text="API key（secrets.json）"
            android:textColor="@color/st_text_primary"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:text="系统设置（settings.json）"
            android:textColor="@color/st_text_primary"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbExtensions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:text="扩展插件（extensions）"
            android:textColor="@color/st_text_primary"
            android:textSize="14sp"
            android:checked="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            style="@style/Widget.STPatch.Button.Tonal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:visibility="gone"
            android:text="完成"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importButton"
            style="@style/Widget.STPatch.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:visibility="gone"
            android:text="导入数据"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
