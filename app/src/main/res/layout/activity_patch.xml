<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202124"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="数据迁移"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:indeterminateTint="#FF03DAC5" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在准备迁移…"
        android:textColor="#BFFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <LinearLayout
        android:id="@+id/categoryBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cbCharacters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="角色卡（characters）"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbChats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="聊天记录（chats）"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbSecrets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API key（secrets.json）"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="系统设置（settings.json）"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbExtensions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="扩展插件（extensions）"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:checked="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/actionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="完成"
            android:backgroundTint="#FF03DAC5"
            android:textColor="#FFFFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="导入数据"
            android:backgroundTint="#FF03DAC5"
            android:textColor="#FFFFFFFF"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
